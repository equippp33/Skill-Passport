# Override for the origin used in candidate links. Normally leave blank:
# development reads it off the request (localhost), and production falls
# back to the domain compiled into src/server/app-url.ts.
# Set it only for another environment — a staging host, or a domain change
# you would rather not rebuild for.
#
# The production and test domains are both compiled into src/server/app-url.ts
# and selected by the host the request arrived on, so neither needs this set.
APP_URL=""

# Local secrets live in the MONOREPO ROOT .env (../../.env), not here.
# App scripts load it via `dotenv -e ../../.env --` (the `with-env` script),
# matching the convention used by the other ThreePointOLabs repos.
#
# Copy this file to ../../.env and fill it in. Never commit real keys.

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill_passport"
# Postgres connections per app instance (default 10). Not a cap on concurrent
# interviews — connections are held only for the milliseconds a query runs.
# DATABASE_POOL_MAX=10

# ----------------------------------------------------------------------------
# Languages — two independent switches
# ----------------------------------------------------------------------------
# App chrome: login, dashboard, setup form, buttons, labels, instructions.
UI_LANGUAGE="english"

# Interview content: questions, follow-ups, Sarvam STT, Sarvam TTS, answer
# evaluation, per-answer feedback and the final report. The candidate speaks
# and is assessed in this language; their transcript is never translated.
INTERVIEW_LANGUAGE="marathi"

# Both allow: english | hindi | marathi
# (Sarvam also supports bengali, gujarati, kannada, malayalam, odia, punjabi,
#  tamil and telugu — each needs a dictionary in src/config/messages/ before
#  it can be selected. An unsupported value is a startup error, never a
#  silent fallback.)

# ----------------------------------------------------------------------------
# Interview brain — which provider generates and evaluates
# ----------------------------------------------------------------------------
# "sarvam" (current) or "openai". Speech (Sarvam STT/TTS) is used either way;
# this switches only the reasoning layer. Both satisfy the same structured
# -JSON contract, so flipping this value is the whole migration in either
# direction — no code change.
AI_PROVIDER="sarvam"

# ----------------------------------------------------------------------------
# OpenAI — question generation, answer evaluation, final summary
# ----------------------------------------------------------------------------
# Currently UNUSED (AI_PROVIDER=sarvam), but kept wired up so a switch back
# needs no code change. Optional: without it the app runs and is browsable,
# but interviews cannot start under AI_PROVIDER=openai.
OPENAI_API_KEY=""
# Any model that supports the Responses API with Structured Outputs.
OPENAI_MODEL="gpt-4.1-mini"

# ----------------------------------------------------------------------------
# Sarvam AI — speech-to-text and text-to-speech
# ----------------------------------------------------------------------------
SARVAM_API_KEY=""
# STT model: saaras:v3 (default) or saaras:v4
SARVAM_STT_MODEL="saaras:v3"
# TTS model: bulbul:v3 (default) or bulbul:v2
SARVAM_TTS_MODEL="bulbul:v3"
# Voice. bulbul:v3 default is "shubh"; bulbul:v2 default is "anushka".
SARVAM_TTS_SPEAKER="shubh"

# Live conversational turns: questions, follow-ups, re-asks.
SARVAM_CHAT_MODEL="sarvam-105b-conversations"
# Scoring and the closing report (reasoning model, slower).
SARVAM_ANALYSIS_MODEL="sarvam-105b"

# ----------------------------------------------------------------------------
# Cloudflare R2 — interview question/answer audio storage
# ----------------------------------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
# Account-level S3 endpoint: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=""
# Dedicated PRIVATE bucket for interview recordings. Do not enable public
# access on it: playback is served through an authenticated, presigned route.
CLOUDFLARE_R2_BUCKET="ai-interview-recordings"
# Key prefix inside the bucket.
CLOUDFLARE_R2_PREFIX="skill-passport"
# Optional and unused by the app; kept only for diagnostics.
# CLOUDFLARE_R2_PUBLIC_URL=""

# ----------------------------------------------------------------------------
# Escape hatches
# ----------------------------------------------------------------------------
# Set to 1 to skip env validation (used by CI and container builds).
# SKIP_ENV_VALIDATION=1
