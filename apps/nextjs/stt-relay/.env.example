# STT relay — runtime env (template; fill in real values on the host, never commit)
#
# The relay is a standalone WebSocket bridge to Sarvam's realtime STT. It reads
# only these three vars. Inject them on the container (Coolify) or pass with
# --env-file when running locally.

# Required — the relay exits on boot without it. Same Sarvam key as the app.
SARVAM_API_KEY=""

# Port the relay listens on. Must match the port Coolify/your proxy exposes.
STT_RELAY_PORT="3100"

# Realtime STT model (batch saaras:v3 is used by the app; the relay is streaming).
SARVAM_STT_REALTIME_MODEL="saaras:v3-realtime"
