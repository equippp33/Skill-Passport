{
  "name": "@skill-passport/nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "dev": "pnpm with-env next dev --port 3000",
    "build": "pnpm with-env next build",
    "start": "pnpm with-env next start",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm with-env vitest run",
    "test:watch": "pnpm with-env vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "user:create": "pnpm with-env node scripts/create-user.mjs",
    "check:limits": "pnpm with-env node scripts/check-limits.mjs",
    "seed:admin": "pnpm with-env node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@skill-passport/shared": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucia": "^3.2.2",
    "next": "catalog:",
    "openai": "^7.10.0",
    "postgres": "^3.4.9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@skill-passport/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.11",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8",
    "drizzle-kit": "^0.31.10",
    "eslint": "catalog:",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^5",
    "vitest": "^3"
  }
}
